// Driver core model
model Driver {
  id              String    @id @default(uuid())
  userId          String    @unique
  name            String
  phone           String    @unique
  licenseNumber   String    @unique
  nidaNumber      String    @unique
  status          String    @default("offline")
  vehicleType     String?
  vehiclePlate    String?
  isActive        Boolean   @default(true)
  isBusy          Boolean   @default(false)
  version         Int       @default(0)
  currentLat      Float?
  currentLng      Float?
  lastLocationAt  DateTime?
  rating          Float     @default(5.0)
  totalDeliveries Int       @default(0)
  totalEarnings   Decimal   @db.Decimal(18, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  kycStatus      KYCStatus @default(NOT_SUBMITTED)
  kycSubmittedAt DateTime?
  kycVerifiedAt  DateTime?
  kycVerifiedBy  String?
  frozenAt       DateTime?

  user          User                @relation(fields: [userId], references: [id])
  wallet        Wallet?
  kyc           DriverKYC?
  withdrawals   Withdrawal[]
  orders        Order[]
  advances      DriverAdvance[]
  achievements  DriverAchievement[]
  DriverMission DriverMission[]

  @@index([kycStatus])
  @@index([frozenAt])
  @@index([status])
  @@index([isActive, currentLat, currentLng])
  @@index([rating])
  @@index([currentLat, currentLng])
  @@index([status, currentLat, currentLng])
}

// Driver Wallet
model Wallet {
  id             String   @id @default(uuid())
  driverId       String   @unique
  userId         String?  @unique
  balance        Decimal  @db.Decimal(18, 2)
  pendingBalance Decimal  @db.Decimal(18, 2)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  driver       Driver        @relation(fields: [driverId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([driverId, version])
  @@index([userId])
}

// Driver KYC
model DriverKYC {
  id       String @id @default(uuid())
  driverId String @unique
  driver   Driver @relation(fields: [driverId], references: [id])

  nidaNumber  String?
  fullName    String?
  dateOfBirth DateTime?

  licenseCardImage String?
  nidaCardImage    String?
  passportPhoto    String?
  selfieImage      String?

  licenseNumber String?
  plateNumber   String?
  vehicleType   String?

  kycStatus       KYCStatus @default(NOT_SUBMITTED)
  rejectionReason String?
  verifiedBy      String?
  verifiedAt      DateTime?
  submittedAt     DateTime?
  frozenAt        DateTime?
  unfrozenAt      DateTime?

  verificationAttempts    Int       @default(0)
  lastVerificationRequest DateTime?
  notes                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kycStatus])
  @@index([driverId])
  @@index([frozenAt])
}

// Driver operations
model Withdrawal {
  id          String           @id @default(uuid())
  driverId    String
  requestId   String           @unique
  amount      Decimal
  status      WithdrawalStatus @default(pending)
  phone       String?
  reference   String?          @unique
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([status])
  @@index([driverId, status])
}

model DriverAdvance {
  id                  String    @id @default(uuid())
  driverId            String
  driver              Driver    @relation(fields: [driverId], references: [id])
  amount              Decimal   @db.Decimal(18, 2)
  remainingBalance    Decimal   @db.Decimal(18, 2)
  interestRate        Float
  repaymentPercentage Float
  dailyRepayment      Decimal   @db.Decimal(18, 2)
  status              String    @default("active")
  startDate           DateTime  @default(now())
  expectedEndDate     DateTime
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  repayments DriverRepayment[]

  @@index([driverId])
  @@index([status])
}

model DriverRepayment {
  id             String        @id @default(uuid())
  advanceId      String
  advance        DriverAdvance @relation(fields: [advanceId], references: [id])
  amount         Decimal       @db.Decimal(18, 2)
  date           DateTime      @default(now())
  earningsAmount Decimal

  @@index([advanceId])
  @@index([date])
}

model DriverAchievement {
  id            String   @id @default(uuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  achievementId String
  points        Int
  awardedAt     DateTime @default(now())

  @@unique([driverId, achievementId])
  @@index([driverId])
  @@index([awardedAt])
}

model DriverMission {
  id String @id @default(cuid())
  driverId  String
  missionId String
  reward    Float
  createdAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, missionId])
}