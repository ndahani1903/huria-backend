// Merchant core model
model Merchant {
  id           String       @id @default(uuid())
  userId       String       @unique
  name         String
  phone        String
  businessName String?
  businessType String?
  merchantType MerchantType @default(GENERAL_ECOMMERCE)

  coverImage String?
  logoImage  String?

  preparationTime Int?     @default(30)
  cuisineType     String?
  dietaryTags     String[] @default([])

  isAcceptingOrders   Boolean @default(true)
  maxDeliveryRadiusKm Float?  @default(40)

  hasBarcodeScanner        Boolean  @default(false)
  aisleCategories          String[] @default([])
  supportsBulkDiscount     Boolean  @default(false)
  expressDeliveryAvailable Boolean  @default(false)

  pickupAddress String?
  pickupLat     Float?
  pickupLng     Float?

  tier           String   @default("basic")
  commissionRate Float    @default(0.05)
  verified       Boolean  @default(false)
  rating         Float    @default(0)
  totalSales     Int      @default(0)
  totalRevenue   Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  kycStatus      KYCStatus @default(NOT_SUBMITTED)
  kycSubmittedAt DateTime?
  kycVerifiedAt  DateTime?
  kycVerifiedBy  String?
  frozenAt       DateTime?

  // Relations
  user                User                  @relation(fields: [userId], references: [id])
  products            Product[]
  orders              Order[]
  wallet              MerchantWallet?
  kyc                 MerchantKYC?
  escrowMerchants     EscrowMerchant[]
  advances            MerchantAdvance[]
  PromoCode           PromoCode[]
  FBUWarehouseRequest FBUWarehouseRequest[]
  storeReviews        StoreReview[]
  operatingHours      OperatingHours[]
  deliveryZones       DeliveryZone[]
  DriverDispatchQueue DriverDispatchQueue[]
  MerchantWithdrawal  MerchantWithdrawal[]

  @@index([kycStatus])
  @@index([frozenAt])
  @@index([businessName])
  @@index([rating, totalSales])
}

// Merchant Wallet & Financials
model MerchantWallet {
  id               String    @id @default(uuid())
  merchantId       String    @unique
  balance          Decimal   @default(0) @db.Decimal(18, 2)
  pendingBalance   Decimal   @default(0) @db.Decimal(18, 2)
  totalWithdrawn   Decimal   @default(0) @db.Decimal(18, 2)
  totalEarned      Decimal   @default(0) @db.Decimal(18, 2)
  lastWithdrawalAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  merchant     Merchant              @relation(fields: [merchantId], references: [id])
  withdrawals  MerchantWithdrawal[]
  transactions MerchantTransaction[]
}

model MerchantTransaction {
  id           String   @id @default(uuid())
  walletId     String
  amount       Decimal  @db.Decimal(18, 2)
  type         String
  orderId      String
  withdrawalId String?
  status       String   @default("pending")
  description  String?
  reference    String?  @unique
  createdAt    DateTime @default(now())

  wallet     MerchantWallet      @relation(fields: [walletId], references: [id])
  withdrawal MerchantWithdrawal? @relation(fields: [withdrawalId], references: [id])

  @@index([walletId])
  @@index([orderId])
  @@index([createdAt])
}

model MerchantWithdrawal {
  id              String           @id @default(uuid())
  merchantId      String
  walletId        String
  amount          Decimal          @db.Decimal(18, 2)
  phoneNumber     String
  accountName     String?
  accountNumber   String?
  bankName        String?
  paymentMethod   String           @default("mobile_money")
  status          WithdrawalStatus @default(pending)
  rejectionReason String?
  approvedBy      String?
  approvedAt      DateTime?
  processedAt     DateTime?
  reference       String?          @unique
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  wallet              MerchantWallet        @relation(fields: [walletId], references: [id])
  merchant            Merchant              @relation(fields: [merchantId], references: [id])
  MerchantTransaction MerchantTransaction[]

  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
}

// Merchant KYC
model MerchantKYC {
  id         String   @id @default(uuid())
  merchantId String   @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  nidaNumber                 String?
  fullName                   String?
  dateOfBirth                DateTime?
  businessRegistrationNumber String?

  nidaCardImage        String?
  passportPhoto        String?
  selfieImage          String?
  businessLicenseImage String?
  logoImage            String?

  businessAddress String?
  businessLat     Float?
  businessLng     Float?

  kycStatus       KYCStatus @default(NOT_SUBMITTED)
  rejectionReason String?
  verifiedBy      String?
  verifiedAt      DateTime?
  submittedAt     DateTime?
  frozenAt        DateTime?
  unfrozenAt      DateTime?

  verificationAttempts    Int       @default(0)
  lastVerificationRequest DateTime?
  notes                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kycStatus])
  @@index([merchantId])
  @@index([frozenAt])
}

// Merchant advances/loans
model MerchantAdvance {
  id                  String    @id @default(uuid())
  merchantId          String
  amount              Decimal   @db.Decimal(18, 2)
  remainingBalance    Decimal   @db.Decimal(18, 2)
  interestRate        Float
  repaymentPercentage Float
  dailyRepayment      Decimal   @db.Decimal(18, 2)
  status              String    @default("active")
  startDate           DateTime  @default(now())
  expectedEndDate     DateTime
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  repayments Repayment[]
  merchant   Merchant    @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([status])
}

model Repayment {
  id          String          @id @default(uuid())
  advanceId   String
  advance     MerchantAdvance @relation(fields: [advanceId], references: [id])
  amount      Decimal         @db.Decimal(18, 2)
  date        DateTime        @default(now())
  salesAmount Decimal         @db.Decimal(18, 2)

  @@index([advanceId])
  @@index([date])
}

// Merchant operations (hours, zones, reviews)
model OperatingHours {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  dayOfWeek  Int
  opensAt    String
  closesAt   String
  isClosed   Boolean  @default(false)
  isSpecial  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([merchantId, dayOfWeek])
  @@index([merchantId])
}

model DeliveryZone {
  id             String   @id @default(uuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  name           String
  polygon        Json?
  minDeliveryFee Decimal  @default(0) @db.Decimal(10, 2)
  maxRadiusKm    Float
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([merchantId])
  @@index([isActive])
}

model StoreReview {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  rating     Float
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([merchantId, userId])
  @@index([merchantId])
  @@index([rating])
}

model FBUWarehouseRequest {
  id                       String           @id @default(uuid())
  orderId                  String           @unique
  order                    Order            @relation(fields: [orderId], references: [orderId])
  merchantId               String
  merchant                 Merchant         @relation(fields: [merchantId], references: [id])
  merchantName             String?
  merchantPhone            String?
  merchantAddress          String?
  merchantPickupLat        Float?
  merchantPickupLng        Float?
  items                    Json
  totalWeight              Float
  totalAmount              Decimal          @db.Decimal(18, 2)
  status                   FBURequestStatus @default(pending_pickup)
  pickupScheduledAt        DateTime?
  pickupCompletedAt        DateTime?
  warehouseReceivedAt      DateTime?
  assignedWarehouseStaffId String?
  notes                    String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([orderId])
  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
}

model PromoCode {
  id             String   @id @default(uuid())
  code           String   @unique
  type           String
  discountType   String   @default("percentage")
  discountValue  Int
  minOrderAmount Decimal? @db.Decimal(18, 2)
  maxDiscount    Decimal? @db.Decimal(18, 2)
  usageLimit     Int?
  usagePerUser   Int      @default(1)
  merchantId     String?
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchant Merchant?    @relation(fields: [merchantId], references: [id])
  usages   PromoUsage[]

  @@index([code])
  @@index([type])
  @@index([merchantId])
  @@index([startDate, endDate])
  @@index([isActive])
}

model PromoUsage {
  id             String   @id @default(uuid())
  promoId        String
  userId         String
  orderId        String
  discountAmount Decimal  @db.Decimal(18, 2)
  usedAt         DateTime @default(now())

  promo PromoCode @relation(fields: [promoId], references: [id])
  user  User      @relation(fields: [userId], references: [id])
  order Order     @relation(fields: [orderId], references: [orderId])

  @@unique([promoId, userId])
  @@index([userId])
  @@index([promoId])
  @@index([orderId])
}