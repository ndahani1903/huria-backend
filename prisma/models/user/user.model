// Core User model with relations
model User {
  id                   String    @id @default(uuid())
  name                 String
  phone                String    @unique
  email                String    @unique
  password             String
  avatar               String?
  emailVerified        Boolean   @default(false)
  emailVerifiedAt      DateTime?
  profileImage         String?
  refreshTokenHash     String?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  phoneVerified     Boolean   @default(false)
  phoneVerifiedAt   DateTime?
  phoneOTP          String?
  phoneOTPExpiresAt DateTime?
  phoneOTPAttempts  Int       @default(0)

  verifyToken        String?
  verifyTokenExpires DateTime?

  role       Role      @default(customer)
  userRoleId String?
  userRole   userRole? @relation(fields: [userRoleId], references: [id])
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  // Relations
  driver                   Driver?
  merchant                 Merchant?
  orders                   Order[]
  pushTokens               PushToken[]
  disputes                 Dispute[]
  auditLogs                AuditLog[]
  payments                 Payment[]
  wallets                  Wallet[]
  Subscription             Subscription[]
  UserPromotion            UserPromotion[]
  AgreementSignature       AgreementSignature[]
  addresses                Address[]
  Review                   Review[]
  UserNotificationSettings UserNotificationSettings?
  PromoUsage               PromoUsage[]
  SupportTicket            SupportTicket[]
  SupportMessage           SupportMessage[]
  HuriaCard                HuriaCard?
  HCoinTransaction         HCoinTransaction[]
  StoreReview              StoreReview[]
  CustomerSearchAnalytics  CustomerSearchAnalytics[]
  CustomerProductAffinity  CustomerProductAffinity[]

  postShares    PostShare[]
  postMentions  PostMention[]
  messageReads  MessageRead[]
  reelViews     ReelView[]
  reelComments  ReelComment[]
  reelLikes     ReelLike[]
  savedPosts    SavedPost[]
  socialProfile SocialProfile?
  presence      UserPresence?

  followers Follow[] @relation("FollowingRelation")
  following Follow[] @relation("FollowerRelation")

  blockedUsers   UserBlock[] @relation("Blocker")
  blockedByUsers UserBlock[] @relation("Blocked")

  sentStoryReplies     StoryReply[] @relation("StoryReplySender")
  receivedStoryReplies StoryReply[] @relation("StoryReplyReceiver")

  socialPosts     SocialPost[]
  socialComments  SocialComment[]
  socialPostLikes SocialPostLike[]
  socialStories   SocialStory[]
  storyViews      StoryView[]
  storyReactions  StoryReaction[]
  reels           Reel[]
  conversations   ConversationMember[]
  messages        Message[]
  notifications   SocialNotification[]
  searchHistory   SocialSearchHistory[]

  triggeredNotifications SocialNotification[] @relation("NotificationActor")

  ActivityLog ActivityLog[]

  @@index([email])
  @@index([phone])
  @@index([role, createdAt])
  @@index([createdAt(sort: Desc)])
}

// User Role Management
model userRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  users       User[]
}

model Permission {
  id         String   @id @default(uuid())
  name       String
  userRoleId String
  userRole   userRole @relation(fields: [userRoleId], references: [id])

  @@unique([userRoleId, name])
}

// User-specific subscriptions and promotions
model Subscription {
  id                      String                    @id @default(uuid())
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id])
  tier                    String
  price                   Decimal
  status                  String                    @default("active")
  startDate               DateTime                  @default(now())
  endDate                 DateTime
  autoRenew               Boolean                   @default(true)
  paymentMethod           String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  metadata                Json?
  SubscriptionTransaction SubscriptionTransaction[]

  @@unique([userId, status])
  @@index([userId, status])
  @@index([userId])
  @@index([status, endDate])
}

model SubscriptionTransaction {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  userId         String
  amount         Decimal
  status         String
  reference      String?      @unique
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
  @@index([userId])
  @@index([createdAt])
}

model UserPromotion {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  value     Int
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AgreementSignature {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  agreementType    String
  agreementVersion String
  agreementHash    String
  signatureData    String   @map("text")
  ipAddress        String?
  userAgent        String?
  signedAt         DateTime @default(now())

  @@unique([userId, agreementType])
  @@index([userId])
  @@index([signedAt])
}