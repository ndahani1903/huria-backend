generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  driver
  merchant
  admin
}

enum OrderStatus {
  pending
  paid
  assigned
  ready_for_pickup
  arrived_pickup
  picked_up
  in_transit
  en_route
  delivered
  completed
  cancelled
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
  held
  released
}

enum TransactionType {
  credit
  debit
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum DisputeStatus {
  open
  resolved
  rejected
}

enum WithdrawalStatus {
  pending
  approved
  rejected
  processing
  completed
  failed
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  phone                String    @unique
  email                String    @unique
  password             String
  avatar               String?
  emailVerified        Boolean   @default(false)
  emailVerifiedAt      DateTime?
  profileImage         String?
  refreshTokenHash     String?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  verifyToken        String?
  verifyTokenExpires DateTime?

  role      Role      @default(customer)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  driver                   Driver?
  merchant                 Merchant?
  orders                   Order[]
  pushTokens               PushToken[]
  disputes                 Dispute[]
  auditLogs                AuditLog[]
  payments                 Payment[]
  wallets                  Wallet[]
  Subscription             Subscription[]
  UserPromotion            UserPromotion[]
  AgreementSignature       AgreementSignature[]
  addresses                Address[]
  Review                   Review[]
  UserNotificationSettings UserNotificationSettings?

  // Indexes
  @@index([email])
  @@index([phone])
  @@index([role, createdAt])
  @@index([createdAt(sort: Desc)])
}

model Driver {
  id              String    @id @default(uuid())
  userId          String    @unique
  name            String
  phone           String    @unique
  status          String    @default("offline")
  vehicleType     String?
  vehiclePlate    String?
  isActive        Boolean   @default(true)
  isBusy          Boolean   @default(false)
  version         Int       @default(0)
  currentLat      Float?
  currentLng      Float?
  lastLocationAt  DateTime?
  rating          Float     @default(5.0)
  totalDeliveries Int       @default(0)
  totalEarnings   Decimal   @db.Decimal(18, 2) //for lending calculation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user         User                @relation(fields: [userId], references: [id])
  wallet       Wallet?
  withdrawals  Withdrawal[]
  orders       Order[]
  advances     DriverAdvance[]
  achievements DriverAchievement[]

  @@index([status])
  @@index([isActive, currentLat, currentLng])
  @@index([rating])
  @@index([currentLat, currentLng])
  @@index([status, currentLat, currentLng])
}

model Merchant {
  id           String  @id @default(uuid())
  userId       String  @unique
  name         String
  phone        String
  businessName String?
  businessType String?

  // ✅ ADD THESE
  pickupAddress String?
  pickupLat     Float?
  pickupLng     Float?

  tier           String   @default("basic")
  commissionRate Float    @default(0.05)
  verified       Boolean  @default(false)
  rating         Float    @default(0)
  totalSales     Int      @default(0)
  totalRevenue   Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user            User              @relation(fields: [userId], references: [id])
  products        Product[]
  orders          Order[]
  wallet          MerchantWallet?
  escrowMerchants EscrowMerchant[]
  advances        MerchantAdvance[]

  @@index([businessName])
  @@index([rating, totalSales])
}

model Product {
  id            String   @id @default(uuid())
  name          String
  price         Decimal  @db.Decimal(18, 2)
  stock         Int      @default(0)
  reservedStock Int      @default(0)
  description   String?
  isActive      Boolean  @default(true)
  images        Json?
  category      String
  version       Int      @default(0)
  averageRating Float?   @default(0)
  merchantId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  merchant   Merchant         @relation(fields: [merchantId], references: [id])
  orderItems OrderItem[]
  variants   ProductVariant[]
  Review     Review[]

  // Indexes
  @@index([name, category, description])
  @@index([name])
  @@index([category])
  @@index([merchantId, createdAt])
  @@index([category, price])
  @@index([createdAt(sort: Desc)])
  @@index([stock, merchantId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String?
  color String?
  sku   String  @unique
  price Float?
  stock Int     @default(0)

  createdAt DateTime @default(now())
}

model Order {
  id                 String      @id @default(uuid())
  orderId            String      @unique
  userId             String
  merchantId         String
  driverId           String?
  amount             Decimal     @db.Decimal(18, 2)
  status             OrderStatus @default(pending)
  tripStage          OrderStatus @default(pending)
  otp                String?
  otpExpiresAt       DateTime?
  otpAttempts        Int         @default(0)
  discountPercentage Float?
  discountAmount     Decimal?
  finalAmount        Decimal?

  pickupLat         Float?
  pickupLng         Float?
  pickupAddress     String?
  pickupArrivalTime DateTime?
  pickupTime        DateTime?

  deliveryAddress     String?
  deliveryLat         Float?
  deliveryLng         Float?
  deliveryAddressId   String?
  deliveryArrivalTime DateTime?
  deliveryTime        DateTime?

  merchantConfirmed Boolean @default(false)
  readyForPickup    Boolean @default(false)
  routeGeometry     Json? // Store route coordinates for map
  estimatedDistance Float?
  estimatedDuration Int? // in minutes

  distance      Float?
  deliveryFee   Decimal?
  driverEarning Decimal?
  platformFee   Decimal?
  instructions  String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user      User        @relation(fields: [userId], references: [id])
  merchant  Merchant    @relation(fields: [merchantId], references: [id])
  driver    Driver?     @relation(fields: [driverId], references: [id])
  payment   Payment?
  items     OrderItem[]
  escrow    Escrow?
  disputes  Dispute[]
  Address   Address?    @relation(fields: [addressId], references: [id])
  addressId String?

  // Indexes
  @@index([status])
  @@index([driverId])
  @@index([userId])
  @@index([merchantId, status, createdAt])
  @@index([status, createdAt])
  @@index([pickupLat, pickupLng]) // For nearby order queries
  @@index([userId, status])
  @@index([userId, status, amount, createdAt], map: "idx_orders_user_covering")
  @@index([tripStage]) // For filtering by trip stage
  @@index([readyForPickup]) // For finding ready orders
  @@index([merchantConfirmed]) // For merchant order status
  @@index([deliveryLat, deliveryLng]) // For delivery area queries
  @@index([createdAt(sort: Desc)]) // For recent orders
  @@index([driverId, status])
  @@index([merchantId, status])
  @@index([createdAt, status])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String // "Home", "Work", "Other"
  address   String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders Order[]

  @@index([userId])
  @@index([userId, isDefault]) // For fetching user's default address
  @@index([isDefault])
  @@index([lat, lng]) // For geolocation queries
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  productId  String
  merchantId String
  quantity   Int
  price      Decimal @db.Decimal(18, 2)

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String        @unique
  userId           String
  amount           Decimal       @db.Decimal(18, 2)
  status           PaymentStatus @default(pending)
  paymentMethod    String?
  transactionRef   String?
  idempotencyKey   String?       @unique
  gatewayReference String?       @unique
  metadata         Json?
  failureReason    String?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  order        Order         @relation(fields: [orderId], references: [orderId])
  user         User          @relation(fields: [userId], references: [id])
  refunds      Refund[]
  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([idempotencyKey])
  @@index([status, createdAt])
  @@index([gatewayReference])
}

model Refund {
  id        String   @id @default(uuid())
  paymentId String
  amount    Decimal  @db.Decimal(18, 2)
  reason    String?
  status    String
  createdAt DateTime @default(now())

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id])
}

model Wallet {
  id             String   @id @default(uuid())
  driverId       String   @unique
  userId         String?  @unique
  balance        Decimal  @db.Decimal(18, 2)
  pendingBalance Decimal  @db.Decimal(18, 2)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  driver       Driver        @relation(fields: [driverId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([driverId, version])
  @@index([userId])
}

model Transaction {
  id           String            @id @default(uuid())
  walletId     String
  paymentId    String?
  amount       Decimal
  type         TransactionType
  balanceAfter Decimal
  reference    String?           @unique
  status       TransactionStatus @default(pending)
  metadata     Json?
  createdAt    DateTime          @default(now())

  // Relations
  wallet  Wallet   @relation(fields: [walletId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@index([reference])
  @@index([createdAt(sort: Desc)])
}

model Withdrawal {
  id          String           @id @default(uuid())
  driverId    String
  amount      Decimal
  status      WithdrawalStatus @default(pending)
  phone       String?
  reference   String?          @unique
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  // Relations
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([status])
  @@index([driverId, status])
}

model Dispute {
  id           String        @id @default(uuid())
  orderId      String
  reason       String
  status       DisputeStatus @default(open)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  order      Order @relation(fields: [orderId], references: [orderId])
  resolvedBy User? @relation(fields: [resolvedById], references: [id])
}

model Escrow {
  id         String    @id @default(uuid())
  orderId    String    @unique
  amount     Decimal   @db.Decimal(18, 2)
  status     String // held | released | refunded | disputed
  customerId String
  driverId   String?
  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  // Relations
  order           Order            @relation(fields: [orderId], references: [orderId])
  escrowMerchants EscrowMerchant[]
}

model EscrowMerchant {
  id         String    @id @default(uuid())
  escrowId   String
  merchantId String
  amount     Decimal   @db.Decimal(18, 2)
  status     String // pending | released | refunded
  orderId    String
  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  // Relations
  escrow   Escrow   @relation(fields: [escrowId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([escrowId, merchantId])
}

model MerchantWallet {
  id             String   @id @default(uuid())
  merchantId     String   @unique
  balance        Decimal  @default(0)
  pendingBalance Decimal  @default(0)
  totalEarned    Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  merchant     Merchant              @relation(fields: [merchantId], references: [id])
  withdrawals  MerchantWithdrawal[]
  transactions MerchantTransaction[]
}

model MerchantTransaction {
  id          String   @id @default(uuid())
  walletId    String
  amount      Decimal  @db.Decimal(18, 2)
  type        String // credit | debit
  orderId     String
  status      String // pending | completed | failed
  description String?
  createdAt   DateTime @default(now())

  // Relations
  wallet MerchantWallet @relation(fields: [walletId], references: [id])
}

model MerchantWithdrawal {
  id          String           @id @default(uuid())
  walletId    String
  amount      Decimal          @db.Decimal(18, 2)
  phone       String
  status      WithdrawalStatus @default(pending)
  reference   String?          @unique
  createdAt   DateTime         @default(now())
  processedAt DateTime?

  // Relations
  wallet MerchantWallet @relation(fields: [walletId], references: [id])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  deviceType String // ios | android | web
  active     Boolean  @default(true)
  lastUsed   DateTime @default(now())
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  meta       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  severity   String? // info warn critical

  // Relations
  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model MerchantAdvance {
  id                  String    @id @default(uuid())
  merchantId          String
  amount              Decimal   @db.Decimal(18, 2)
  remainingBalance    Decimal   @db.Decimal(18, 2)
  interestRate        Float
  repaymentPercentage Float
  dailyRepayment      Decimal   @db.Decimal(18, 2)
  status              String    @default("active")
  startDate           DateTime  @default(now())
  expectedEndDate     DateTime
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  repayments Repayment[]
  merchant   Merchant    @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([status])
}

model Repayment {
  id          String          @id @default(uuid())
  advanceId   String
  advance     MerchantAdvance @relation(fields: [advanceId], references: [id])
  amount      Decimal         @db.Decimal(18, 2)
  date        DateTime        @default(now())
  salesAmount Decimal         @db.Decimal(18, 2)

  @@index([advanceId])
  @@index([date])
}

model DriverAdvance {
  id                  String    @id @default(uuid())
  driverId            String
  driver              Driver    @relation(fields: [driverId], references: [id])
  amount              Decimal   @db.Decimal(18, 2)
  remainingBalance    Decimal   @db.Decimal(18, 2)
  interestRate        Float
  repaymentPercentage Float // % of daily earnings
  dailyRepayment      Decimal   @db.Decimal(18, 2)
  status              String    @default("active") // active, completed, defaulted
  startDate           DateTime  @default(now())
  expectedEndDate     DateTime
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  repayments DriverRepayment[]

  @@index([driverId])
  @@index([status])
}

// Driver Repayment model
model DriverRepayment {
  id             String        @id @default(uuid())
  advanceId      String
  advance        DriverAdvance @relation(fields: [advanceId], references: [id])
  amount         Decimal       @db.Decimal(18, 2)
  date           DateTime      @default(now())
  earningsAmount Decimal // Daily earnings used for repayment

  @@index([advanceId])
  @@index([date])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model UserNotificationSettings {
  id           String  @id @default(uuid())
  userId       String  @unique
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)

  // Specific notification types
  orderConfirmations Boolean @default(true)
  paymentUpdates     Boolean @default(true)
  deliveryUpdates    Boolean @default(true)
  promotions         Boolean @default(false)
  marketingEmails    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Subscription {
  id                      String                    @id @default(uuid())
  userId                  String
  user                    User                      @relation(fields: [userId], references: [id])
  tier                    String // basic, plus, premium
  price                   Decimal
  status                  String                    @default("active") // active, cancelled, expired, failed
  startDate               DateTime                  @default(now())
  endDate                 DateTime
  autoRenew               Boolean                   @default(true)
  paymentMethod           String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  SubscriptionTransaction SubscriptionTransaction[]

  @@index([userId, status])
  @@index([userId])
  @@index([status, endDate])
}

model UserPromotion {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // welcome_discount, referral, seasonal
  value     Int // discount percentage or amount
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SubscriptionTransaction {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  userId         String
  amount         Decimal
  status         String // pending, completed, failed
  reference      String?      @unique
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
  @@index([userId])
  @@index([createdAt])
}

model DriverAchievement {
  id            String   @id @default(uuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  achievementId String // first_delivery, ten_deliveries, etc.
  points        Int
  awardedAt     DateTime @default(now())

  @@unique([driverId, achievementId])
  @@index([driverId])
  @@index([awardedAt])
}

model AgreementSignature {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  agreementType    String // merchant, driver
  agreementVersion String
  agreementHash    String
  signatureData    String   @map("text") // Base64 signature image
  ipAddress        String?
  userAgent        String?
  signedAt         DateTime @default(now())

  @@unique([userId, agreementType])
  @@index([userId])
  @@index([signedAt])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @unique
  payload     Json?
  processedAt DateTime?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  userName  String
  rating    Int
  comment   String
  images    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId]) // One review per user per product
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
}
