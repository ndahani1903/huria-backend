generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  driver
  merchant
  admin
}

enum OrderStatus {
  pending
  paid
  assigned
  ready_for_pickup
  arrived_pickup
  picked_up
  in_transit
  en_route
  delivered
  completed
  cancelled
  archived
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
  held
  released
}

enum TransactionType {
  credit
  debit
  withdrawal
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum DisputeStatus {
  open
  resolved
  rejected
}

enum WithdrawalStatus {
  pending
  approved
  rejected
  processing
  completed
  failed
}

enum WeightBracket {
  LIGHT
  MEDIUM
  HEAVY
  VERY_HEAVY
  BULK
}

enum VehicleType {
  motorcycle
  bajaj
  truck
}

enum ShippingMode {
  LOCAL_DISPATCH
  FBU_COURIER
}

enum FBURequestStatus {
  pending_pickup
  pickup_scheduled
  picked_up
  warehouse_received
  dispatched
  completed
}

enum MerchantType {
  GENERAL_ECOMMERCE
  SUPERMARKET
  RESTAURANT
}

enum OrderPriority {
  NORMAL
  HIGH
  URGENT
}

// KYC Verification Status enum
enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  FROZEN
}

enum CardTransactionType {
  TOPUP
  PURCHASE
  REFUND
  REVERSAL
  CASHBACK
  ADJUSTMENT
  SUBSCRIPTION
  TRANSFER
}

enum PrivacyLevel {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum FollowStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  CONTACT
}

enum NotificationType {
  FOLLOW
  FOLLOW_ACCEPTED
  POST_LIKE
  POST_COMMENT
  COMMENT_REPLY
  STORY_LIKE
  STORY_VIEW
  MESSAGE
  MENTION
  TAG
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  ANGRY
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  phone                String    @unique
  email                String    @unique
  password             String
  avatar               String?
  emailVerified        Boolean   @default(false)
  emailVerifiedAt      DateTime?
  profileImage         String?
  refreshTokenHash     String?
  passwordResetToken   String?
  passwordResetExpires DateTime?

  // Phone verification
  phoneVerified     Boolean   @default(false)
  phoneVerifiedAt   DateTime?
  phoneOTP          String? // Store hashed OTP
  phoneOTPExpiresAt DateTime?
  phoneOTPAttempts  Int       @default(0)

  verifyToken        String?
  verifyTokenExpires DateTime?

  role       Role      @default(customer)
  userRoleId String? // New field for custom role
  userRole   userRole? @relation(fields: [userRoleId], references: [id])
  status     String    @default("active") // active, suspended, banned
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  // Relations
  driver                   Driver?
  merchant                 Merchant?
  orders                   Order[]
  pushTokens               PushToken[]
  disputes                 Dispute[]
  auditLogs                AuditLog[]
  payments                 Payment[]
  wallets                  Wallet[]
  Subscription             Subscription[]
  UserPromotion            UserPromotion[]
  AgreementSignature       AgreementSignature[]
  addresses                Address[]
  Review                   Review[]
  UserNotificationSettings UserNotificationSettings?
  PromoUsage               PromoUsage[]
  SupportTicket            SupportTicket[]
  SupportMessage           SupportMessage[]
  HuriaCard                HuriaCard?
  HCoinTransaction         HCoinTransaction[]
  StoreReview              StoreReview[]
  CustomerSearchAnalytics  CustomerSearchAnalytics[]
  CustomerProductAffinity  CustomerProductAffinity[]

  postShares    PostShare[]
  postMentions  PostMention[]
  messageReads  MessageRead[]
  reelViews     ReelView[]
  reelComments  ReelComment[]
  reelLikes     ReelLike[]
  savedPosts    SavedPost[]
  socialProfile SocialProfile?
  presence      UserPresence?

  followers Follow[] @relation("FollowingRelation")
  following Follow[] @relation("FollowerRelation")

  blockedUsers   UserBlock[] @relation("Blocker")
  blockedByUsers UserBlock[] @relation("Blocked")

  sentStoryReplies     StoryReply[] @relation("StoryReplySender")
  receivedStoryReplies StoryReply[] @relation("StoryReplyReceiver")

  socialPosts     SocialPost[]
  socialComments  SocialComment[]
  socialPostLikes SocialPostLike[]
  socialStories   SocialStory[]
  storyViews      StoryView[]
  storyReactions  StoryReaction[]
  reels           Reel[]
  conversations   ConversationMember[]
  messages        Message[]
  notifications   SocialNotification[]
  searchHistory   SocialSearchHistory[]

  triggeredNotifications SocialNotification[] @relation("NotificationActor")

  ActivityLog ActivityLog[]

  // Indexes
  @@index([email])
  @@index([phone])
  @@index([role, createdAt])
  @@index([createdAt(sort: Desc)])
}

model Driver {
  id              String    @id @default(uuid())
  userId          String    @unique
  name            String
  phone           String    @unique
  licenseNumber   String    @unique
  nidaNumber      String    @unique
  status          String    @default("offline")
  vehicleType     String?
  vehiclePlate    String?
  isActive        Boolean   @default(true)
  isBusy          Boolean   @default(false)
  version         Int       @default(0)
  currentLat      Float?
  currentLng      Float?
  lastLocationAt  DateTime?
  rating          Float     @default(5.0)
  totalDeliveries Int       @default(0)
  totalEarnings   Decimal   @db.Decimal(18, 2) //for lending calculation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // KYC Fields
  kycStatus      KYCStatus @default(NOT_SUBMITTED)
  kycSubmittedAt DateTime?
  kycVerifiedAt  DateTime?
  kycVerifiedBy  String?
  frozenAt       DateTime?

  // Relations
  user          User                @relation(fields: [userId], references: [id])
  wallet        Wallet?
  kyc           DriverKYC?
  withdrawals   Withdrawal[]
  orders        Order[]
  advances      DriverAdvance[]
  achievements  DriverAchievement[]
  DriverMission DriverMission[]

  @@index([kycStatus])
  @@index([frozenAt])
  @@index([status])
  @@index([isActive, currentLat, currentLng])
  @@index([rating])
  @@index([currentLat, currentLng])
  @@index([status, currentLat, currentLng])
}

model Merchant {
  id           String       @id @default(uuid())
  userId       String       @unique
  name         String
  phone        String
  businessName String?
  businessType String?
  merchantType MerchantType @default(GENERAL_ECOMMERCE)

  coverImage String? // URL for restaurant/supermarket cover photo
  logoImage  String? // Optional logo image

  // Restaurant specific fields
  preparationTime Int?     @default(30) // Minutes
  cuisineType     String? // e.g., "Italian", "Chinese", "Local"
  dietaryTags     String[] @default([]) // ["Veg", "Halal", "Gluten-Free"]

  isActive            Boolean @default(true)
  isAcceptingOrders   Boolean @default(true)
  maxDeliveryRadiusKm Float?  @default(40) // Maximum delivery distance

  // Supermarket specific fields
  hasBarcodeScanner        Boolean  @default(false)
  aisleCategories          String[] @default([])
  supportsBulkDiscount     Boolean  @default(false)
  expressDeliveryAvailable Boolean  @default(false)

  // ✅ ADD THESE
  pickupAddress String?
  pickupLat     Float?
  pickupLng     Float?

  tier           String   @default("basic")
  commissionRate Float    @default(0.05)
  verified       Boolean  @default(false)
  rating         Float    @default(0)
  totalSales     Int      @default(0)
  totalRevenue   Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // KYC Fields
  kycStatus      KYCStatus @default(NOT_SUBMITTED)
  kycSubmittedAt DateTime?
  kycVerifiedAt  DateTime?
  kycVerifiedBy  String?
  frozenAt       DateTime?

  // Relations
  user                User                  @relation(fields: [userId], references: [id])
  products            Product[]
  orders              Order[]
  wallet              MerchantWallet?
  kyc                 MerchantKYC?
  escrowMerchants     EscrowMerchant[]
  advances            MerchantAdvance[]
  PromoCode           PromoCode[]
  FBUWarehouseRequest FBUWarehouseRequest[]
  storeReviews        StoreReview[]
  operatingHours      OperatingHours[]
  deliveryZones       DeliveryZone[]
  DriverDispatchQueue DriverDispatchQueue[]
  MerchantWithdrawal  MerchantWithdrawal[]

  @@index([kycStatus])
  @@index([frozenAt])
  @@index([businessName])
  @@index([rating, totalSales])
}

model Product {
  id            String  @id @default(uuid())
  name          String
  price         Decimal @db.Decimal(18, 2)
  stock         Int     @default(0)
  reservedStock Int     @default(0)
  description   String?
  isActive      Boolean @default(true)
  images        Json?
  category      String

  weightBracket   WeightBracket @default(LIGHT)
  allowedVehicles VehicleType[] @default([motorcycle, bajaj, truck])

  // ========== NEW FIELDS FOR FILTERING & DEALS ==========
  tags        String[] @default([]) // ["gift", "deal", "premium", "new"]
  rating      Float    @default(0) // 0-5 stars
  reviewCount Int      @default(0)
  gender      String?  @default("unisex") // "men", "women", "boys", "girls", "unisex"

  // Flash Sale Fields
  isFlashSale   Boolean   @default(false)
  flashSaleEnd  DateTime? // When flash sale ends
  flashDiscount Int       @default(0) // Discount percentage during flash sale

  // Deal Fields
  isDeal       Boolean   @default(false)
  dealEndDate  DateTime?
  dealDiscount Int       @default(0)

  // New User Offer Fields
  newUserDiscount  Int     @default(0) // Special discount for new users (0-100%)
  discountEligible Boolean @default(false) // Can this product be discounted for new users

  // ✅ NEW FIELDS FOR RESTAURANT
  isAvailable     Boolean  @default(true)
  preparationTime Int?     @default(15) // Minutes per item
  dietaryInfo     String[] @default([])
  isSpicy         Boolean  @default(false)
  isVegetarian    Boolean  @default(false)
  isVegan         Boolean  @default(false)
  isGlutenFree    Boolean  @default(false)

  // ✅ NEW FIELDS FOR SUPERMARKET
  barcode              String?   @unique
  expiryDate           DateTime?
  weight               Float? // In grams
  unit                 String? // "kg", "g", "liter", "piece"
  aisleLocation        String? // "Aisle 4, Shelf B"
  minimumOrderQuantity Int       @default(1)
  maximumOrderQuantity Int?      @default(99)
  bulkDiscountQuantity Int? // Buy 3 get discount
  bulkDiscountPercent  Int? // Discount percentage for bulk
  nutritionalInfo      Json? // Calories, protein, carbs, etc.

  // ✅ MODIFIERS/ADD-ONS for Restaurant items
  modifiers Json? @default("[]") // [{name:"Extra Cheese", price:2000}]

  // Legacy fields
  version       Int      @default(0)
  averageRating Float?   @default(0)
  merchantId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Search keywords for better product discovery
  searchKeywords     String[]  @default([]) // ["burger", "fast food", "grilled", "beef"]
  synonymTerms       String[]  @default([]) // ["hamburger", "patty"] - related search terms
  popularSearchCount Int       @default(0) // How many times this product appears in searches
  lastSearchAt       DateTime? // Last time product was searched

  // Customer behavior tracking
  viewCount      Int   @default(0) // Total views
  uniqueViewers  Int   @default(0) // Unique customers who viewed
  addToCartCount Int   @default(0) // Times added to cart
  purchaseCount  Int   @default(0) // Times purchased
  conversionRate Float @default(0) // (purchases / views) * 100

  // Personalization data
  customerAffinityScore Float @default(0) // ML score for customer preferences

  // Relations
  merchant                Merchant                  @relation(fields: [merchantId], references: [id])
  orderItems              OrderItem[]
  variants                ProductVariant[]
  Review                  Review[]
  CustomerProductAffinity CustomerProductAffinity[]
  ProductSearchIndex      ProductSearchIndex?

  // Indexes
  @@index([name, category, description])
  @@index([name])
  @@index([category])
  @@index([merchantId, createdAt])
  @@index([category, price])
  @@index([createdAt(sort: Desc)])
  @@index([stock, merchantId])
  @@index([isFlashSale, flashSaleEnd])
  @@index([isDeal, dealEndDate])
  @@index([gender])
  @@index([tags])
  @@index([rating])
}

// ✅ NEW: Customer Search Analytics for ML learning
model CustomerSearchAnalytics {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Search session data
  searchTerm   String // What customer searched for
  searchDate   DateTime @default(now())
  searchSource String // "search_bar", "category_filter", "recommended"

  // Results interaction
  resultsCount   Int      @default(0)
  productsViewed String[] @default([]) // Product IDs they viewed
  productClicked String? // Product ID they clicked
  timeSpentMs    Int      @default(0) // Time spent on search results

  // Purchase outcome
  addedToCart        Boolean @default(false)
  purchased          Boolean @default(false)
  purchasedProductId String?

  // Device info
  deviceType  String? // mobile, desktop
  locationLat Float?
  locationLng Float?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([searchTerm])
  @@index([searchDate])
  @@index([userId, searchDate])
}

// ✅ NEW: Customer Product Affinity (ML learning data)
model CustomerProductAffinity {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Affinity scores (0-100)
  viewScore     Float @default(0) // Based on view frequency
  searchScore   Float @default(0) // Based on search matches
  purchaseScore Float @default(0) // Based on purchase history
  overallScore  Float @default(0) // Weighted average

  // Interaction counts
  viewCount      Int @default(0)
  searchCount    Int @default(0)
  clickCount     Int @default(0)
  addToCartCount Int @default(0)
  purchaseCount  Int @default(0)

  // Time decay
  lastInteraction DateTime @default(now())
  weightDecay     Float    @default(1.0) // Reduces over time for old interactions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId, overallScore])
  @@index([productId])
  @@index([overallScore])
}

// ✅ NEW: Popular Search Terms (for autocomplete and trending)
model PopularSearchTerm {
  id               String   @id @default(uuid())
  term             String   @unique
  searchCount      Int      @default(0)
  resultCount      Int      @default(0)
  clickThroughRate Float    @default(0)
  lastSearched     DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([searchCount])
  @@index([lastSearched])
}

// ✅ NEW: Product Search Index (for full-text search optimization)
model ProductSearchIndex {
  id        String  @id @default(uuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  // Pre-computed search fields
  nameVector    String? // Processed name for better matching
  keywordVector String? // Processed keywords
  combinedText  String? // All searchable text combined

  // Search boost scores
  nameBoost     Float @default(1.0)
  keywordBoost  Float @default(0.8)
  categoryBoost Float @default(0.6)

  updatedAt DateTime @updatedAt

  @@index([nameVector])
  @@index([keywordVector])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String?
  color String?
  sku   String  @unique
  price Float?
  stock Int     @default(0)

  createdAt DateTime @default(now())
}

model Order {
  id                 String      @id @default(uuid())
  orderId            String      @unique
  userId             String
  merchantId         String
  driverId           String?
  amount             Decimal     @db.Decimal(18, 2)
  totalAmount        Decimal?    @db.Decimal(18, 2)
  status             OrderStatus @default(pending)
  tripStage          OrderStatus @default(pending)
  otp                String?
  otpExpiresAt       DateTime?
  otpAttempts        Int         @default(0)
  discountPercentage Float?      @default(0)
  discountAmount     Decimal?    @default(0) @db.Decimal(18, 2)
  finalAmount        Decimal?    @db.Decimal(18, 2)

  shippingMode           ShippingMode @default(LOCAL_DISPATCH)
  assignedVehicle        VehicleType?
  logisticsMetadata      Json?        @default("{}")
  fbuPickupScheduled     Boolean      @default(false)
  fbuPickupScheduledAt   DateTime?
  fbuWarehouseReceived   Boolean      @default(false)
  fbuWarehouseReceivedAt DateTime?

  // ✅ NEW FIELDS FOR RESTAURANT/SUPERMARKET
  orderPriority          OrderPriority @default(NORMAL)
  readyForPickupAt       DateTime?
  preparationStartedAt   DateTime?
  preparationCompletedAt DateTime?
  estimatedReadyTime     DateTime?
  autoCancelAt           DateTime?

  // ✅ Restaurant specific
  requiresDriverAt   DateTime? // When to dispatch driver
  acceptanceDeadline DateTime? // 5 min deadline
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?

  // ✅ Supermarket specific
  packingCompletedAt DateTime?
  aislePickingNotes  String?

  // Relations
  fbuRequest FBUWarehouseRequest?

  pickupLat         Float?
  pickupLng         Float?
  pickupAddress     String?
  pickupArrivalTime DateTime?
  pickupTime        DateTime?

  deliveryAddress     String?
  deliveryLat         Float?
  deliveryLng         Float?
  deliveryAddressId   String?
  deliveryArrivalTime DateTime?
  deliveryTime        DateTime?

  merchantConfirmed Boolean @default(false)
  readyForPickup    Boolean @default(false)
  routeGeometry     Json? // Store route coordinates for map
  estimatedDistance Float?
  estimatedDuration Int? // in minutes

  distance      Float?
  deliveryFee   Decimal?
  driverEarning Decimal?
  platformFee   Decimal?
  instructions  String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expiresAt     DateTime?
  metadata      Json?

  // Relations
  user                User                 @relation(fields: [userId], references: [id])
  merchant            Merchant             @relation(fields: [merchantId], references: [id])
  driver              Driver?              @relation(fields: [driverId], references: [id])
  payment             Payment?
  items               OrderItem[]
  escrow              Escrow?
  disputes            Dispute[]
  Address             Address?             @relation(fields: [addressId], references: [id])
  addressId           String?
  PromoUsage          PromoUsage[]
  DriverDispatchQueue DriverDispatchQueue?
  ManualDispatchQueue ManualDispatchQueue?

  // Indexes
  @@index([status])
  @@index([driverId])
  @@index([userId])
  @@index([merchantId, status, createdAt])
  @@index([status, createdAt])
  @@index([pickupLat, pickupLng]) // For nearby order queries
  @@index([userId, status])
  @@index([userId, status, amount, createdAt], map: "idx_orders_user_covering")
  @@index([tripStage]) // For filtering by trip stage
  @@index([readyForPickup]) // For finding ready orders
  @@index([merchantConfirmed]) // For merchant order status
  @@index([deliveryLat, deliveryLng]) // For delivery area queries
  @@index([createdAt(sort: Desc)]) // For recent orders
  @@index([driverId, status])
  @@index([merchantId, status])
  @@index([createdAt, status])
  @@index([status, expiresAt])
}

model FBUWarehouseRequest {
  id                       String           @id @default(uuid())
  orderId                  String           @unique
  order                    Order            @relation(fields: [orderId], references: [orderId])
  merchantId               String
  merchant                 Merchant         @relation(fields: [merchantId], references: [id])
  merchantName             String?
  merchantPhone            String?
  merchantAddress          String?
  merchantPickupLat        Float?
  merchantPickupLng        Float?
  items                    Json // Store cart items
  totalWeight              Float
  totalAmount              Decimal          @db.Decimal(18, 2)
  status                   FBURequestStatus @default(pending_pickup)
  pickupScheduledAt        DateTime?
  pickupCompletedAt        DateTime?
  warehouseReceivedAt      DateTime?
  assignedWarehouseStaffId String?
  notes                    String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([orderId])
  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String // "Home", "Work", "Other"
  address   String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders Order[]

  @@index([userId])
  @@index([userId, isDefault]) // For fetching user's default address
  @@index([isDefault])
  @@index([lat, lng]) // For geolocation queries
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  productId  String
  merchantId String
  quantity   Int
  price      Decimal @db.Decimal(18, 2)

  // Relations
  order             Order               @relation(fields: [orderId], references: [id])
  product           Product             @relation(fields: [productId], references: [id])
  OrderItemModifier OrderItemModifier[]
}

model Payment {
  id      String        @id @default(uuid())
  orderId String        @unique
  userId  String
  amount  Decimal       @db.Decimal(18, 2)
  status  PaymentStatus @default(pending)

  paymentMethod String? // azampay, huria_card, wallet

  transactionRef   String?
  idempotencyKey   String? @unique
  gatewayReference String? @unique

  metadata      Json?
  failureReason String?

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  order        Order         @relation(fields: [orderId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  refunds      Refund[]
  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([idempotencyKey])
  @@index([status, createdAt]) // Composite for status + time queries
  @@index([status]) // For filtering by status
  @@index([orderId]) // For looking up payment by order
  @@index([userId]) // For user payment history
  @@index([completedAt]) // For date range queries
  @@index([gatewayReference]) // For webhook lookups 
}

model Refund {
  id        String   @id @default(uuid())
  paymentId String
  amount    Decimal  @db.Decimal(18, 2)
  reason    String?
  status    String
  createdAt DateTime @default(now())

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id])
}

model Wallet {
  id             String   @id @default(uuid())
  driverId       String   @unique
  userId         String?  @unique
  balance        Decimal  @db.Decimal(18, 2)
  pendingBalance Decimal  @db.Decimal(18, 2)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  driver       Driver        @relation(fields: [driverId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([driverId, version])
  @@index([userId])
}

model Transaction {
  id           String            @id @default(uuid())
  walletId     String
  paymentId    String?
  amount       Decimal
  type         TransactionType
  balanceAfter Decimal
  reference    String?           @unique
  status       TransactionStatus @default(pending)
  metadata     Json?
  createdAt    DateTime          @default(now())

  // Relations
  wallet  Wallet   @relation(fields: [walletId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@index([reference])
  @@index([createdAt(sort: Desc)])
}

model Withdrawal {
  id          String           @id @default(uuid())
  driverId    String
  requestId   String           @unique
  amount      Decimal
  status      WithdrawalStatus @default(pending)
  phone       String?
  reference   String?          @unique
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  // Relations
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([status])
  @@index([driverId, status])
}

model Dispute {
  id           String        @id @default(uuid())
  orderId      String
  reason       String
  status       DisputeStatus @default(open)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  order      Order @relation(fields: [orderId], references: [orderId])
  resolvedBy User? @relation(fields: [resolvedById], references: [id])
}

model Escrow {
