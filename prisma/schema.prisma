model HuriaCard {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Card details
  cardNumber String  @unique // e.g., HURIA-XXXX-XXXX
  cardName   String  @default("HURIA Card")
  balance    Decimal @default(0) @db.Decimal(18, 2)
  version    Int     @default(0)

  // HCoins (1 HCoin = 100 TZS)
  hcoins Int @default(0)

  // Transaction limits
  dailyLimit    Decimal  @default(500000) @db.Decimal(18, 2)
  monthlyLimit  Decimal  @default(5000000) @db.Decimal(18, 2)
  dailySpent    Decimal  @default(0) @db.Decimal(18, 2)
  monthlySpent  Decimal  @default(0) @db.Decimal(18, 2)
  lastResetDate DateTime @default(now())

  // Features
  cashbackRate      Float     @default(2.0) // 2% cashback on purchases
  discountRate      Float     @default(0) // Extra discount for card users
  isActive          Boolean   @default(true)
  isLocked          Boolean   @default(false)
  lastTransactionAt DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  CardTransaction CardTransaction[]

  @@index([userId])
  @@index([cardNumber])
}

model HCoinTransaction {
