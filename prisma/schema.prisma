  cashbackAmount  Decimal             @default(0) @db.Decimal(18, 2)
  status          String              @default("pending") // pending, completed, failed 
  gatewayVerified Boolean             @default(false)
  createdAt       DateTime            @default(now())
  expiresAt       DateTime?
  updatedAt       DateTime            @updatedAt

